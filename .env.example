# Environment Configuration Example
# Copy this file to .env and update with your values

# Flask
FLASK_ENV=production
FLASK_DEBUG=False

# Server
PORT=5000
HOST=0.0.0.0

# Google Analytics ID (update with your tracking ID)
GOOGLE_ANALYTICS_ID=G-JWCGJSZ5VC

# Security (set to False in production for HTTPS)
SECURE_PROXY_HEADER=X-Forwarded-Proto
